{
  "name": "pi-zai-mcp",
  "version": "0.2.3",
  "description": "Unofficial pi package that exposes Z.ai MCP server tools for web search, URL reading, repository reading, and vision workflows.",
  "type": "module",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "extension",
    "mcp",
    "z-ai",
    "zai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-zai-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-zai-mcp/issues"
  },
  "homepage": "https://github.com/fitchmultz/pi-zai-mcp#readme",
  "files": [
    "extensions",
    "src",
    "README.md",
    "PI_1_0_QUALIFICATION.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts"
  ],
  "scripts": {
    "check:compat": "npm run check",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:policy && oxlint --config oxlint.config.ts --deny-warnings .",
    "lint:agent": "npm run lint -- --format=agent",
    "lint:fix": "npm run lint:policy && oxlint --config oxlint.config.ts --fix .",
    "lint:policy": "node scripts/check-lint-directives.mjs",
    "format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --write .",
    "format:check": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --check .",
    "test:quality": "node --experimental-strip-types --test test/quality-*.test.mjs",
    "test:runtime": "node --experimental-strip-types --test test/native-runtime.test.mjs",
    "test": "npm run test:quality && npm run test:runtime",
    "quality": "npm run lint:agent && npm run format:check && npm run test:quality",
    "build": "npm pack --dry-run",
    "check": "npm run quality && npm run typecheck && npm run smoke && npm run test:runtime && npm run build",
    "release:dry-run": "npm run ci && npm publish --dry-run",
    "smoke": "node --experimental-strip-types scripts/smoke.mjs",
    "ci": "npm run check && npm audit --omit=dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@z_ai/mcp-server": "0.1.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "@types/node": "^24.13.3",
    "oxc-parser": "0.153.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typebox": "1.3.34",
    "typescript": "^7.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/zai-mcp-search.ts",
      "./extensions/zai-mcp-reader.ts",
      "./extensions/zai-mcp-zread.ts",
      "./extensions/zai-mcp-vision.ts",
      "./extensions/zai-mcp-status.ts"
    ]
  },
  "packageManager": "npm@11.21.0",
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "overrides": {
    "@hono/node-server": "^2.1.3"
  }
}
